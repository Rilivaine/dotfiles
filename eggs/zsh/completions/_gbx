#compdef gbx

_gbx() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-f -D --force)-f[Force delete unmerged branches]' \
    '(-f -D --force)-D[Force delete unmerged branches]' \
    '(-f -D --force)--force[Force delete unmerged branches]' \
    '1:against ref:_gbx_refs'
}

_gbx_refs() {
  local expl
  local -a refs

  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    _message 'not a git repository'
    return 1
  fi

  refs=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)"})
  _describe -t refs 'git ref' refs -qS -
}
