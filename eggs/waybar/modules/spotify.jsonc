    "custom/spotify": {
        "exec": "mediaplayer.py --player spotify",
        "format": " {}",
        "rotate": ${r_deg},
        "return-type": "json",
        "on-click": "toggle_spotify.sh",
        "on-click-right": "playerctl next --player spotify",
        "on-click-middle": "playerctl previous --player spotify",
        "on-scroll-up": "volume_control.sh -p spotify i",
        "on-scroll-down": "volume_control.sh -p spotify d",
        "max-length": 80,
        "escape": true,
        "tooltip": true
    },

